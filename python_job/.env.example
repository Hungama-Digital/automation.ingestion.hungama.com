# Input and run artifacts (all relative to python_job folder)
INPUT_FILE=./input/track_ids.xls
LOG_DIR=./logs
STATE_FILE=./state/progress.json

# Workload controls
BATCH_SIZE=100
CONCURRENCY=5
BATCH_PAUSE_SEC=0
MAX_BATCHES_PER_RUN=0
RESUME=true

# Network controls
REQUEST_TIMEOUT_SEC=30
REQUEST_RETRIES=2
REQUEST_RETRY_BACKOFF_SEC=1

# APIs
SOLR_BASE_URL=http://solr.hungama.com/solr/music/select
SOLR_USERNAME=
SOLR_PASSWORD=
MEDIA_SUFFIXES=_320.mp3,_256.mp3,_128.mp3
MEDIA_URL_PREFIX=https://media.hungama.com

MDN_BASE_URL=http://mdn.hungama.com/streaming
MDN_AUTH_HEADER=Basic aHVuZ2FtYS5jb206aHVuZ2FtYS5jb20=
MDN_QUERY_STRING=duration=PT24H0M0S&cdn=s3&agent=application&cms=ms2&protocol=filedl

# Local output (transcoded files)
OUTPUT_DIR=~/Downloads
OUTPUT_EXT=wav

# ffmpeg
FFMPEG_PATH=ffmpeg
FFMPEG_THREADS=1
FFMPEG_ARGS=-t 00:00:30.0 -ar 8000 -ac 1 -c:a pcm_alaw
